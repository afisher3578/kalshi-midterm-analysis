# Copy to .env at the repo root (git-ignored; the CLI loads it at startup and never overrides a variable
# already set in your shell) or export in your own shell. Never commit real values. Values are never printed.
# None is required: Kalshi, Wikipedia and Bluesky (unauthenticated) run without keys. A connector whose key is
# missing is skipped with the reason. Keys are read from the environment at request time and never written anywhere.

# X API bearer token (pay-per-use). Get it from the X developer portal: https://developer.x.com/en/portal/dashboard
X_BEARER_TOKEN=
# Media Cloud API key (free account). Get it from your profile at https://search.mediacloud.org
MEDIACLOUD_API_KEY=
# Guardian Open Platform key (free developer tier). Register at https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# New York Times Article Search key. Create an app at https://developer.nytimes.com/get-started
NYT_API_KEY=
# Optional Bluesky handle and app password (lets the connector try cursor paging). Bluesky app: Settings > Privacy and security > App passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# Reddit API credentials (requires approval). Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key. Create it in Google Cloud Console: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
